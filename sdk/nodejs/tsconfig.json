{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "blueprint.ts",
        "buildkiteQueue.ts",
        "config/index.ts",
        "config/vars.ts",
        "egressPolicy.ts",
        "getBlueprint.ts",
        "getBlueprints.ts",
        "getBuildkiteQueue.ts",
        "getBuildkiteQueues.ts",
        "getEgressPolicies.ts",
        "getEgressPolicy.ts",
        "getGithubJobs.ts",
        "getGithubProfile.ts",
        "getGithubProfiles.ts",
        "getInstance.ts",
        "getInstanceIngress.ts",
        "getInstances.ts",
        "getRegistryDefaultPolicy.ts",
        "getRegistryImages.ts",
        "getRegistryRepositories.ts",
        "getRegistryRepositoryPolicy.ts",
        "getRevokableToken.ts",
        "getRevokableTokens.ts",
        "getSharedImage.ts",
        "getSharedImages.ts",
        "getTenant.ts",
        "getTenantGroup.ts",
        "getTenantGroups.ts",
        "getTenantMembers.ts",
        "getTenantPolicies.ts",
        "getTenants.ts",
        "getUsage.ts",
        "getVaultObject.ts",
        "getVaultObjects.ts",
        "getVolumes.ts",
        "githubProfile.ts",
        "index.ts",
        "instance.ts",
        "instanceIngress.ts",
        "provider.ts",
        "registryDefaultPolicy.ts",
        "registryRepositoryPolicy.ts",
        "revokableToken.ts",
        "sharedImage.ts",
        "tenant.ts",
        "tenantGroup.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts",
        "vaultObject.ts"
    ]
}
